{
  "name": "@signavis/sun-charts",
  "version": "0.2.0",
  "description": "Sun altitude, twilight phases and day length for a place and date, with small SVG charts and dials (from SignaVis)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "LimitlessGreen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LimitlessGreen/SignaVis.git",
    "directory": "packages/sun-charts"
  },
  "keywords": ["sun", "twilight", "sunrise", "sunset", "day length", "bioacoustics", "svg", "chart"],
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./style.css": "./dist/sun-charts.css"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/sun-charts.css','dist/sun-charts.css')\"",
    "test": "node --experimental-strip-types --test 'tests/*.test.mjs'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.8.0"
  }
}
