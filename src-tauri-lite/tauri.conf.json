{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignaVis Lite",
  "version": "1.0.5",
  "identifier": "io.github.limitlessgreen.signavis.lite",
  "build": {
    "frontendDist": "../_site-lite",
    "beforeBuildCommand": "npm run build:lite"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
