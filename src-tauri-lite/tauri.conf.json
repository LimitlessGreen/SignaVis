{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignaVis Lite",
  "version": "1.0.5",
  "identifier": "io.github.limitlessgreen.signavis.lite",
  "build": {
    "frontendDist": "../_site-lite",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:lite",
    "beforeBuildCommand": "npm run build:lite"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https: http://localhost:* http://127.0.0.1:* ws://localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
