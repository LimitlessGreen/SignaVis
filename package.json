{
  "name": "signavis",
  "version": "1.4.3",
  "description": "DAW-like audio player with waveform + spectrogram for analysis",
  "readme": "README.md",
  "type": "module",
  "main": "./dist/birdnet-player.esm.js",
  "module": "./dist/birdnet-player.esm.js",
  "unpkg": "./dist/birdnet-player.iife.js",
  "types": "./types/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*.worker*.js"
  ],
  "files": [
    "dist/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/birdnet-player.esm.js",
      "types": "./types/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.esm.js",
      "types": "./types/core.d.ts"
    },
    "./label-table": {
      "import": "./dist/label-table.esm.js",
      "types": "./types/label-table.d.ts"
    },
    "./core.css": "./dist/core.css",
    "./label-table.css": "./dist/label-table.css",
    "./iife": "./dist/birdnet-player.iife.js",
    "./style": {
      "types": "./types/style.d.ts",
      "default": "./dist/birdnet-player.css"
    },
    "./tokens": {
      "types": "./types/style.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "peerDependencies": {
    "wavesurfer.js": "^7"
  },
  "peerDependenciesMeta": {
    "wavesurfer.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.8.0",
    "dockview-core": "8.9.1",
    "jsoneditor": "^10.4.3",
    "onnxruntime-web": "1.31.1"
  },
  "keywords": [
    "audio",
    "spectrogram",
    "daw",
    "waveform",
    "signavis"
  ],
  "author": "LimitlessGreen",
  "license": "AGPL-3.0-only",
  "homepage": "https://www.npmjs.com/package/signavis",
  "bugs": {
    "url": "https://github.com/LimitlessGreen/SignaVis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LimitlessGreen/SignaVis.git"
  },
  "scripts": {
    "dev": "node ./scripts/ensure-assets.js && vite",
    "demo:gifs": "uv run --with playwright python -I tools/demo-gifs/demo_gifs.py",
    "dev:analysis-mock": "node ./scripts/mock-analysis-server.mjs",
    "build": "vite build && vite build --mode iife && npm run build:css && node -e \"require('fs').copyFileSync('src/styles/tokens.css','dist/tokens.css'); require('fs').copyFileSync('src-tauri/crates/aw-dsp-wasm/THIRD_PARTY_LICENSES.txt','dist/aw_dsp_wasm.THIRD_PARTY_LICENSES.txt')\" && node ./scripts/generate-types.js",
    "build:desktop": "node ./scripts/ensure-assets.js && npm run build:css && vite build --config demo/vite.demo.config.js",
    "dev:lite": "node ./scripts/ensure-assets.js && vite --config demo/vite.lite.config.js",
    "build:lite": "node ./scripts/ensure-assets.js && npm run build:css && vite build --config demo/vite.lite.config.js",
    "build:wasm": "wasm-pack build src-tauri/crates/aw-dsp-wasm --release --target web --out-dir ../../../src/infrastructure/wasm-dsp/pkg --no-pack && node -e \"require('fs').rmSync('src/infrastructure/wasm-dsp/pkg/.gitignore',{force:true})\"",
    "build:css": "node ./scripts/build-css.mjs",
    "watch:css": "sass --watch src/styles/main.scss:dist/birdnet-player.css --no-source-map",
    "typecheck": "tsc --noEmit --checkers 4",
    "types:generate": "node ./scripts/generate-types.js",
    "taxonomy:build": "node ./scripts/build-birdnet-taxonomy.js --output ./demo/data/birdnet-taxonomy.json --v24-labels ./_birdnet_upstream/birdnet_analyzer/labels/V2.4",
    "pack:check": "npm pack",
    "size:check": "node ./scripts/check-bundle-size.mjs",
    "deps:core": "node ./scripts/module-graph.mjs src/core.ts --sizes",
    "test": "node ./scripts/run-tests.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:birdbox": "node scripts/birdbox/fetch-model.mjs",
    "models:anurapam": "bash scripts/fetch-anurapam.sh",
    "test:birdbox-stream": "node --import tsx scripts/birdbox/stream-parity.mjs",
    "test:analysis-smoke": "node --experimental-loader ./scripts/ignore-styles-loader.mjs --experimental-strip-types --test tests/analysis-backend-e2e-smoke.test.ts",
    "prepare": "npm run build:css && node ./scripts/install-githooks.js",
    "prepack": "npm run build:css",
    "notices:wasm": "node ./scripts/generate-wasm-notices.mjs",
    "sync:assets": "bash ./scripts/sync-assets.sh --no-build",
    "hooks:install": "node ./scripts/install-githooks.js",
    "version:sync": "node ./scripts/sync-version.js",
    "version:check": "bash ./scripts/check-version-sync.sh",
    "release": "bash ./scripts/release.sh",
    "sync-version": "node ./scripts/sync-version.js",
    "desktop:dev": ". \"$HOME/.cargo/env\" && tauri dev",
    "desktop:dev:grpc": ". \"$HOME/.cargo/env\" && AW_GRPC_ADDR=127.0.0.1:50051 tauri dev --features grpc",
    "desktop:build": ". \"$HOME/.cargo/env\" && tauri build",
    "lite:build": "cd src-tauri-lite && tauri build",
    "lite:dev": "cd src-tauri-lite && tauri dev",
    "lite:smoke": "node ./scripts/lite-smoke.mjs",
    "grpc:check": ". \"$HOME/.cargo/env\" && cd src-tauri && cargo check --features grpc",
    "grpc:test": ". \"$HOME/.cargo/env\" && cd src-tauri && cargo test --features grpc",
    "platform:testenv:up": "docker compose -f platform/docker/docker-compose.test.yml up -d --build",
    "platform:testenv:down": "docker compose -f platform/docker/docker-compose.test.yml down",
    "platform:testenv:logs": "docker compose -f platform/docker/docker-compose.test.yml logs -f --tail=200",
    "platform:testenv:ps": "docker compose -f platform/docker/docker-compose.test.yml ps",
    "platform:testenv:local": "node platform/local-testenv.mjs",
    "platform:testenv:local:reset": "node platform/local-testenv.mjs --reset",
    "platform:test:rbac": "npm --prefix platform/api run test:rbac",
    "platform:test:authz": "npm --prefix platform/api run test:authz",
    "platform:test:vertical-slice:local": "node --test platform/tests/vertical-slice.local.test.mjs",
    "desktop:dev:platform-local": "node scripts/dev-desktop-platform-local.mjs",
    "desktop:dev:platform-local:reset": "node scripts/dev-desktop-platform-local.mjs --reset-local"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tensorflow/tfjs": "4.22.0",
    "leaflet": "1.9.4",
    "lucide-static": "^1.8.0",
    "postcss": "^8.5.32",
    "sass": "^1.70.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "wavesurfer.js": "^7.12.6"
  }
}
