---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const app = `${base}/demo/labeling-app.html`;
const docs = `${base}/docs`;

const useCases = [
  { icon: 'audio-lines', title: 'Aufnahme durchhören', text: 'Wer singt da?', href: `${docs}/anwendungsfaelle/aufnahme-durchhoeren/` },
  { icon: 'tag', title: 'Rufe markieren', text: 'Rufe einrahmen und benennen.', href: `${docs}/anwendungsfaelle/rufe-markieren/` },
  { icon: 'search', title: 'Seltene Art suchen', text: 'In Stunden von Material.', href: '#' },
  { icon: 'smartphone', title: 'Unterwegs sichten', text: 'Aufnehmen und prüfen am Handy.', href: '#' },
  { icon: 'list-checks', title: 'Eigene Artenliste', text: 'Nur Arten, die bei dir vorkommen.', href: '#' },
  { icon: 'sparkles', title: 'Ähnliche Rufe finden', text: 'Einen Ruf wählen, alle Treffer sehen.', href: '#' },
];

const features = [
  { video: 'overview.mp4', kicker: 'Überblick', title: 'Alles auf einen Blick', text: 'Sofort sehen, wo etwas los ist – auch bei Stunden.', href: '#' },
  { video: 'labeling.mp4', kicker: 'Markieren', title: 'Markieren in Sekunden', text: 'Rahmen ziehen, Art tippen, fertig.', href: `${docs}/funktionen/labels/` },
  { video: 'magnifier.mp4', kicker: 'Lupe', title: 'Ins Detail zoomen', text: 'Feine Details, ohne den Überblick zu verlieren.', href: '#' },
];
---
<Site title="SignaVis – Vogelstimmen sehen, finden und bestimmen" description="SignaVis ist eine kostenlose Open-Source-App für Bioakustik: Spektrogramme ansehen, Rufe markieren und Arten bestimmen – im Browser, am Handy oder als Desktop-App.">

  <section class="hero">
    <div class="hero-text">
      <h1>Vogelstimmen <span class="accent">sehen</span>.</h1>
      <p class="lede">Im Browser, am Handy oder als App. Kostenlos.</p>
      <div class="cta-row">
        <a class="btn btn-filled" href={app}><Icon name="play" size={20} /> Im Browser starten</a>
        <a class="btn btn-tonal" href={`${docs}/`}><Icon name="book-open" size={20} /> Anleitung</a>
      </div>
      <ul class="trust">
        <li><Icon name="shield-check" size={18} /> Bleibt auf deinem Gerät</li>
        <li><Icon name="code" size={18} /> Open Source</li>
      </ul>
    </div>
    <div class="hero-visual">
      <img class="shot-desktop" src={`${base}/media/app-desktop.png`} alt="SignaVis am Computer: Spektrogramm einer Vogelaufnahme" width="1440" height="860" />
      <img class="shot-phone" src={`${base}/media/app-mobile.png`} alt="SignaVis am Handy: erkannte Arten prüfen" width="412" height="915" />
    </div>
  </section>

  <section class="section" id="anwendungen">
    <header class="section-head">
      <h2>Was willst du tun?</h2>
    </header>
    <div class="card-grid">
      {useCases.map((u) => (
        <a class="card" href={u.href}>
          <span class="card-icon"><Icon name={u.icon} size={26} /></span>
          <h3>{u.title}</h3>
          <p>{u.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="funktionen">
    <header class="section-head">
      <h2>Funktionen</h2>
    </header>
    {features.map((f, i) => (
      <article class:list={['feature', { flip: i % 2 === 1 }]}>
        <div class="feature-media">
          <video src={`${base}/media/${f.video}`} autoplay muted loop playsinline preload="auto"></video>
        </div>
        <div class="feature-text">
          <span class="kicker">{f.kicker}</span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
          <a class="btn btn-text" href={f.href}>Mehr <Icon name="arrow-right" size={18} /></a>
        </div>
      </article>
    ))}
  </section>

  <section class="section mobile-band">
    <div class="mobile-band-inner">
      <div>
        <span class="kicker">Am Handy</span>
        <h2>Auch am Handy</h2>
        <p>Aufnehmen, Arten erkennen, mit einem Tipp bestätigen.</p>
        <a class="btn btn-filled" href={app}><Icon name="smartphone" size={20} /> Am Handy öffnen</a>
      </div>
      <img src={`${base}/media/app-mobile.png`} alt="SignaVis Handy-Ansicht" width="412" height="915" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="get-grid">
      <a class="get-card" href={app}>
        <Icon name="globe" size={28} />
        <h3>Im Browser</h3>
        <p>Ohne Installation.</p>
      </a>
      <a class="get-card" href="https://github.com/LimitlessGreen/SignaVis/releases">
        <Icon name="download" size={28} />
        <h3>SignaVis Lite</h3>
        <p>Windows, macOS, Linux. Offline.</p>
      </a>
      <a class="get-card" href="https://github.com/sponsors/LimitlessGreen">
        <Icon name="heart" size={28} />
        <h3>Unterstützen</h3>
        <p>Damit SignaVis frei bleibt.</p>
      </a>
    </div>
  </section>
</Site>
